rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidStats(data) {
      return data.keys().hasAll(['totalVisits']) &&
        data.keys().hasOnly(['totalVisits', 'uniqueVisitors', 'lastUpdated', 'dailyDate', 'dailyUniqueVisitors', 'activeReaders', 'dailyHistory', 'deviceBreakdown']) &&
        data.totalVisits is number &&
        data.totalVisits >= 0 &&
        (!('uniqueVisitors' in data) || (data.uniqueVisitors is number && data.uniqueVisitors >= 0)) &&
        (!('lastUpdated' in data) || (data.lastUpdated is string && data.lastUpdated.size() <= 64)) &&
        (!('dailyDate' in data) || (data.dailyDate is string && data.dailyDate.size() <= 16)) &&
        (!('dailyUniqueVisitors' in data) || (data.dailyUniqueVisitors is number && data.dailyUniqueVisitors >= 0)) &&
        (!('activeReaders' in data) || (data.activeReaders is map && data.activeReaders.size() <= 500)) &&
        (!('dailyHistory' in data) || (data.dailyHistory is map && data.dailyHistory.size() <= 90)) &&
        (!('deviceBreakdown' in data) || (data.deviceBreakdown is map && data.deviceBreakdown.size() <= 10));
    }

    function isValidStatsIncrement() {
      return incoming().totalVisits >= existing().totalVisits &&
        incoming().totalVisits <= existing().totalVisits + 1 &&
        (!('uniqueVisitors' in existing()) || (
          'uniqueVisitors' in incoming() &&
          incoming().uniqueVisitors >= existing().uniqueVisitors &&
          incoming().uniqueVisitors <= existing().uniqueVisitors + 1
        ));
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Global application statistics (visits counter)
    match /app_stats/{statsId} {
      allow get: if isValidId(statsId);
      allow list: if false;
      allow create: if isValidId(statsId) &&
                    isValidStats(incoming()) &&
                    incoming().totalVisits == 1 &&
                    (!('uniqueVisitors' in incoming()) || incoming().uniqueVisitors == 1);
      allow update: if isValidId(statsId) &&
                    isValidStats(incoming()) &&
                    incoming().diff(existing()).affectedKeys().hasOnly(['totalVisits', 'uniqueVisitors', 'lastUpdated', 'dailyDate', 'dailyUniqueVisitors', 'activeReaders', 'dailyHistory', 'deviceBreakdown']) &&
                    isValidStatsIncrement();
      allow delete: if false;
    }
  }
}
